# copy to .env on the ERPNext host clone — never commit the real file
ERPNEXT_CONTAINER=erpnext_backend
ERPNEXT_SITE=frontend
ERPNEXT_ADMIN_PASSWORD=change-me-from-vault
ERPNEXT_SMTP_PASSWORD=change-me

# export/backup lane
ERPNEXT_BACKUP_REPO=/opt/iac-erpnext
ERPNEXT_BACKUP_BRANCH=main
ERPNEXT_BACKUP_DIR=/opt/erpnext-backups
ERPNEXT_BACKUP_KEEP=14
